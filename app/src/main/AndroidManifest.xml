<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Declaring CAMERA/RECORD_AUDIO implicitly marks the hardware as required,
        which would hide the app on Play from tablets, ChromeOS and any device
        without a camera. Both are optional here — they are only used for the
        live-class call and material uploads — so mark them not required.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android ≤ 12: needed to read files from storage -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name="com.example.bpscnotes.BpscApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BPSCNotes">

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9485599840415539~3452468884" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />
        <activity
            android:name="com.example.bpscnotes.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BPSCNotes.Splash"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links for shared content URLs (e.g. a shared course:
              https://bpscnotes.in/courses/<uuid>).

              android:autoVerify makes Android fetch
              https://bpscnotes.in/.well-known/assetlinks.json at install time
              and, if this app's signing fingerprint is listed there, open
              these links directly instead of showing a chooser or going to
              the browser. WITHOUT that file published, the filter still
              works but Android treats the app as one option among many.

              The fingerprint that must appear in assetlinks.json is the
              PLAY APP SIGNING key from Play Console (Setup > App integrity),
              not the upload key — Play re-signs the app before it reaches
              devices.

              Paths are listed explicitly so marketing and policy pages
              (/privacy-policy, /terms-of-service, /support, ...) keep opening
              in the browser. WebLink.routeFor() applies the same rule in code
              and returns null for anything it does not recognise.
            -->
            <!--
              VERIFIED links: api.bpscnotes.in only.

              assetlinks.json is served by the API itself (AppLinksModule,
              mapped by nginx to /.well-known/assetlinks.json), so this host
              can actually be verified. bpscnotes.in cannot: it is on
              WordPress.com, which will not serve that file on the plan in
              use — see the second filter below.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api.bpscnotes.in" />
                <data android:pathPrefix="/c/" />
            </intent-filter>

            <!--
              LEGACY links shared before the move to api.bpscnotes.in.

              Deliberately NOT autoVerify. On Android 12+ verification is
              all-or-nothing across every host in an autoVerify filter, so
              leaving bpscnotes.in in the filter above would fail
              verification for api.bpscnotes.in too and break the links that
              CAN work.

              Without autoVerify these open a chooser rather than going
              straight to the app, and a user can still make the app the
              default by hand. That is the most these can do while the site
              stays on WordPress.com.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bpscnotes.in" />
                <data android:scheme="https" android:host="www.bpscnotes.in" />
                <data android:pathPrefix="/courses/" />
                <data android:pathPrefix="/course/" />
                <data android:pathPrefix="/quizzes/" />
                <data android:pathPrefix="/quiz/" />
                <data android:pathPrefix="/answer-writing/" />
                <data android:pathPrefix="/study-materials/" />
                <data android:pathPrefix="/jobs" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name="com.example.bpscnotes.core.notifications.BpscFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel for FCM -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/purple_200" />

        <!-- UCrop — image cropper activity -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>

        <!-- FileProvider — used to share downloaded certificate PDFs
             (CourseDetailScreen "Share Certificate" button) via the
             system share sheet without exposing raw file:// paths. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>