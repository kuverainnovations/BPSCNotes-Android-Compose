<?xml version="1.0" encoding="utf-8"?>
<!--
   FIX: see data_extraction_rules.xml — this is the equivalent rule set
   for Auto Backup on devices below Android 12 (API < 31), which use
   fullBackupContent instead of data-extraction-rules. Without this
   exclusion, "bpsc_prefs" (is_onboarded, auth_token, user_mobile, etc.)
   gets restored on reinstall, making "fresh install" not actually fresh.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="bpsc_prefs.xml"/>
</full-backup-content>