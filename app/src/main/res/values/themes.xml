<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BPSCNotes" parent="Theme.AppCompat.NoActionBar">
        <!-- Match the app's light-mode background — prevents white flash from the
             default AppCompat windowBackground during navigation transitions,
             app minimize animation, and cold-start frame before Compose renders. -->
        <item name="android:windowBackground">#1A6FE8</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- Remove the default activity open/close animation to eliminate flash -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Splash screen theme — shown by the OS during cold start before Activity.onCreate() -->
    <style name="Theme.BPSCNotes.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A6FE8</item>
        <item name="postSplashScreenTheme">@style/Theme.BPSCNotes</item>
    </style>

</resources>